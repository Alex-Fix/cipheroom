# Copy to terraform.tfvars (gitignored) to override defaults. The API token is NOT set here: export HCLOUD_TOKEN.
# scripts/provision.sh passes allowed_ssh_cidrs with your current IP unless you set it here, and the SSH key
# (~/.ssh/id_cipheroom, or CIPHEROOM_SSH_KEY).

# name                = "cipheroom"
# server_type         = "cpx42"      # or cx23 / cx33 / cx43 when available; resized in place
# keep_disk           = true         # false grows the disk too, and rules out resizing back down
# location            = "nbg1"
# allowed_ssh_cidrs   = ["203.0.113.7/32"]
# protection          = true
# media_mode          = "cloudflare"   # scripts/provision.sh passes MEDIA_MODE from deploy/.env(.hetzner)
