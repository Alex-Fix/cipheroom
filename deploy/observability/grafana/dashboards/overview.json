    {
      "type": "logs",
      "title": "Api warnings and errors",
      "description": "Severity Warning and above. Room ids appear only as keyed hashes.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"cipheroom-api\"} | severity_number >= 13",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
