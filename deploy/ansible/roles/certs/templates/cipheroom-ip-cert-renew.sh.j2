#!/bin/bash
# Managed by Ansible (deploy/ansible/roles/certs). Renews the short-lived IP certificate when due (certbot decides,
# following Let's Encrypt's renewal info) and hands it to edge. Runs from cipheroom-cert-renew.timer every 12 hours;
# a failure shows in `systemctl --failed` and, with observability, on the server dashboard's certificate panel.
set -euo pipefail
docker run --rm \
  -v /etc/letsencrypt:/etc/letsencrypt \
  -v {{ certs_acme_dir }}:/acme-webroot \
  {{ certs_certbot_image }} renew --quiet
/usr/local/sbin/cipheroom-cert-deploy
