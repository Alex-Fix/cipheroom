#!/bin/bash
# Managed by Ansible (deploy/ansible/roles/certs). Renews the edge certificate when due (certbot decides, following
# Let's Encrypt's renewal info) and hands it to edge. Runs from cipheroom-cert-renew.timer; a failure shows in
# `systemctl --failed` and, with observability, on the host dashboard's certificate panel.
set -euo pipefail
{% if certs_mode == 'ip' %}
{{ certs_compose_run }} -v /etc/letsencrypt:/etc/letsencrypt -v {{ certs_acme_dir }}:/acme-webroot certbot renew --quiet
{% else %}
{{ certs_compose_run }} -v /etc/letsencrypt:/etc/letsencrypt -v /etc/cipheroom/cloudflare-dns.ini:/cloudflare-dns.ini:ro \
  certbot-dns renew --quiet
{% endif %}
/usr/local/sbin/cipheroom-cert-deploy
