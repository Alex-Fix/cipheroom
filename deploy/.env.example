# Copy to deploy/.env (gitignored) — scripts/secrets.sh does it and lists what still needs filling in.

# Public hostname served through Cloudflare Tunnel (one first-level subdomain → free Universal SSL)
PUBLIC_HOST=cipheroom.alexfix.dev
WEB_PORT=8080

# Cloudflare Realtime TURN — dashboard → Realtime → TURN → create key
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=14400
# true = clients use TURN only (to test the relay path); normally media goes straight to the SFU
TURN_FORCE_RELAY=false

# Cloudflare Realtime SFU (required) — dashboard → Realtime → SFU → create application (app id + app secret)
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=

# Usage guard — stays inside Cloudflare's free tier (SFU and TURN share 1000 GB/month of egress).
# At these percentages of it (decimals allowed, 0.01–100, rising): video is capped (saving), calls go audio-only and
# no new ones start, every call ends.
# Without CF_ACCOUNT_ID / CF_ANALYTICS_API_TOKEN below, the api estimates usage from browser reports.
REALTIME_FREE_TIER_GB=1000
REALTIME_SAVING_PERCENT=80
REALTIME_AUDIO_ONLY_PERCENT=95
REALTIME_PAUSED_PERCENT=99
# false = never limit calls (then the free tier is up to you: keep a Cloudflare billing notification on)
REALTIME_GUARD_ENABLED=true

# Cloudflare Tunnel token (only with: scripts/up.sh --tunnel)
TUNNEL_TOKEN=

# Observability (only with: scripts/up.sh --observability) — docs/plans/2026-10-07-observability-design.md
# Grafana's admin password (12+ characters); Grafana is at https://PUBLIC_HOST/grafana/ behind Cloudflare Access.
GRAFANA_ADMIN_PASSWORD=
# Random key for pseudonymous room ids in logs and traces (e.g. openssl rand -hex 32).
TELEMETRY_SECRET=
# Free-tier usage from Cloudflare's GraphQL Analytics: account id (dashboard URL) + a token with only
# Account Analytics: Read. Optional — without them, usage is estimated from browser reports.
CF_ACCOUNT_ID=
CF_ANALYTICS_API_TOKEN=