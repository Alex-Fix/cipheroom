# Copy to deploy/.env (gitignored) — scripts/secrets.sh does it and lists what still needs filling in.

# Public hostname served through Cloudflare Tunnel (one first-level subdomain → free Universal SSL)
PUBLIC_HOST=cipheroom.alexfix.dev
WEB_PORT=8080
# Optional: Host headers the api accepts ("host1;host2"). Empty = any, so LAN access by IP works at home; a Hetzner
# deploy sets PUBLIC_HOST;localhost by itself.
API_ALLOWED_HOSTS=
# Where the app's "Source code" link points (AGPL-3.0 §13). Running a modified copy? Push it and point this at your
# fork. scripts/up.sh adds the exact commit when the working tree is clean.
SOURCE_URL=https://github.com/Alex-Fix/cipheroom

# Media provider: cloudflare (Cloudflare Realtime SFU + TURN, works without a public IP) or livekit (a LiveKit server on
# this machine's public IP — needs LIVEKIT_* below; docs/plans/2026-10-11-livekit-media-mode-design.md)
MEDIA_MODE=cloudflare
# LiveKit mode: API key and secret (scripts/secrets.sh generates them) and this machine's public IPv4. With LiveKit,
# `scripts/up.sh --direct` + `scripts/ip-cert.sh` serve the app at https://<LIVEKIT_NODE_IP> with no Cloudflare at all.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_NODE_IP=
# Optional TURN over TLS on 443 for networks that allow only HTTPS: a DNS-only (grey cloud) record pointing at this
# machine, and a Cloudflare API token limited to Zone → DNS → Edit on that zone (Let's Encrypt's DNS check)
LIVEKIT_TURN_DOMAIN=
CF_DNS_API_TOKEN=
# On a Hetzner server: a read-only project API token, so the usage guard follows the server's traffic allowance
HCLOUD_READ_TOKEN=

# Cloudflare Realtime TURN — dashboard → Realtime → TURN → create key
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=14400
# true = clients use TURN only (to test the relay path); normally media goes straight to the SFU
TURN_FORCE_RELAY=false

# Cloudflare Realtime SFU (required for MEDIA_MODE=cloudflare) — dashboard → Realtime → SFU → create application (app id + app secret)
CF_SFU_APP_ID=
CF_SFU_APP_SECRET=

# Usage guard — stays inside Cloudflare's free tier (SFU and TURN share 1000 GB/month of egress).
# At these percentages of it (decimals allowed, 0.01–100, rising): video is capped (saving), calls go audio-only and
# no new ones start, every call ends.
# Without CF_ACCOUNT_ID / CF_ANALYTICS_API_TOKEN below, the api estimates usage from browser reports.
REALTIME_FREE_TIER_GB=1000
REALTIME_SAVING_PERCENT=80
REALTIME_AUDIO_ONLY_PERCENT=95
REALTIME_PAUSED_PERCENT=99
# false = never limit calls (then the free tier is up to you: keep a Cloudflare billing notification on)
REALTIME_GUARD_ENABLED=true

# Cloudflare Tunnel token (only with: scripts/up.sh --tunnel)
TUNNEL_TOKEN=

# Observability (only with: scripts/up.sh --observability) — docs/plans/2026-10-07-observability-design.md
# Grafana's admin password (12+ characters); Grafana is at https://PUBLIC_HOST/grafana/ behind its own login.
GRAFANA_ADMIN_PASSWORD=
# Random key for pseudonymous room ids in logs and traces (e.g. openssl rand -hex 32).
TELEMETRY_SECRET=
# Free-tier usage from Cloudflare's GraphQL Analytics: account id (dashboard URL) + a token with only
# Account Analytics: Read. Optional — without them, usage is estimated from browser reports.
CF_ACCOUNT_ID=
CF_ANALYTICS_API_TOKEN=