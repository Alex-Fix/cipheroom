# Copy to deploy/.env (gitignored) — scripts/secrets.sh does it and fills generated secrets.

# Public hostname served through Cloudflare Tunnel (one first-level subdomain → free Universal SSL)
PUBLIC_HOST=cipheroom.alexfix.dev
WEB_PORT=8080

# LiveKit (generated by scripts/secrets.sh)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# URL browsers use for LiveKit signaling: nginx proxies /livekit/ → livekit:7880 on the same host
LIVEKIT_URL=wss://cipheroom.alexfix.dev/livekit

# Cloudflare Realtime TURN — dashboard → Realtime → TURN → create key
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=
TURN_CREDENTIAL_TTL_SECONDS=14400

# Stay inside Cloudflare's free tier (1000 GB/mo)
TURN_MONTHLY_SOFT_LIMIT_GB=800
TURN_MONTHLY_HARD_LIMIT_GB=950

# Cloudflare Tunnel token (only with: scripts/up.sh --tunnel)
TUNNEL_TOKEN=