# Copy to deploy/.env.hetzner (gitignored). scripts/deploy.sh sends deploy/.env to the server with these keys on top,
# so only list what differs from home. Guide: docs/deployment-hetzner.md

# The server's own hostname and Cloudflare Tunnel (Zero Trust → Networks → Tunnels → create a second tunnel, public
# hostname → http://web:8080). Never reuse the home tunnel's token: two stacks behind one tunnel break calls.
PUBLIC_HOST=cipheroom-beta.alexfix.dev
TUNNEL_TOKEN=

# Media on this server instead of Cloudflare Realtime (deployment mode 2): LiveKit on the server's public IP.
# Run scripts/provision.sh after changing it (opens LiveKit's ports), then scripts/deploy.sh.
# MEDIA_MODE=livekit
# TURN over TLS: a DNS-only (grey cloud) A record for this name → the server's IPv4, and a Cloudflare token with only
# Zone → DNS → Edit on alexfix.dev. Leave empty to run without TURN (UDP, then TCP 7881).
# LIVEKIT_TURN_DOMAIN=turn-beta.alexfix.dev
# CF_DNS_API_TOKEN=
# Hetzner Cloud console → Security → API tokens → Read: the usage guard then follows this server's 20 TB allowance.
# HCLOUD_READ_TOKEN=
