# Copy to deploy/.env.hetzner (gitignored). scripts/deploy.sh sends deploy/.env to the server with these keys on top,
# so only list what differs from home. Guide: docs/deployment-hetzner.md

# The server's own hostname and Cloudflare Tunnel (Zero Trust → Networks → Tunnels → create a second tunnel, public
# hostname → http://web:8080). Never reuse the home tunnel's token: two stacks behind one tunnel break calls.
PUBLIC_HOST=cipheroom-beta.alexfix.dev
TUNNEL_TOKEN=
