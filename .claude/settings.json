{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(scripts/doctor.sh)",
      "Bash(scripts/test.sh:*)",
      "Bash(scripts/lint.sh:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npx ng build:*)",
      "Bash(npx ng test:*)",
      "Bash(npx ng generate:*)",
      "Bash(docker compose -f deploy/docker-compose.yml config:*)",
      "Bash(docker compose -f deploy/docker-compose.yml ps:*)",
      "Bash(docker compose -f deploy/docker-compose.yml logs:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./deploy/.env)",
      "Read(./**/.env)",
      "Read(./.certs/**)",
      "Read(./deploy/cloudflared/*.json)"
    ]
  }
}
