<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Presentation layer + composition root. The Mediator source generator runs here. -->

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <PackageReference Include="Mediator.SourceGenerator">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cipheroom.Application\Cipheroom.Application.csproj" />
    <ProjectReference Include="..\Cipheroom.Infrastructure\Cipheroom.Infrastructure.csproj" />
  </ItemGroup>

</Project>
