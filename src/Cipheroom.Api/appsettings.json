{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every exception reaching SignalR's dispatcher is a HubException we threw on purpose; HubExceptionFilter has
      // already logged real failures. Without this, each rejected call (e.g. a bad room id) is an error + stack trace.
      "Microsoft.AspNetCore.SignalR.Internal.DefaultHubDispatcher": "Critical"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Hub": {
      "TokenLimit": 20,
      "TokensPerSecond": 5
    }
  },
  "LiveKit": {
    "Url": "",
    "ApiKey": "",
    "ApiSecret": "",
    "TokenTtlMinutes": 10
  },
  "Turn": {
    "Cloudflare": {
      "KeyId": "",
      "ApiToken": ""
    },
    "CredentialTtlSeconds": 14400
  },
  "Sfu": {
    "Cloudflare": {
      "AppId": "",
      "AppSecret": ""
    }
  }
}
