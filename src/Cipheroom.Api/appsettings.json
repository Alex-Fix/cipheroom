{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Every exception reaching SignalR's dispatcher is a HubException we threw on purpose; HubExceptionFilter has
      // already logged real failures. Without this, each rejected call (e.g. a bad room id) is an error + stack trace.
      "Microsoft.AspNetCore.SignalR.Internal.DefaultHubDispatcher": "Critical",
      // IHttpClientFactory logs every request with its full URL — Cloudflare paths carry the TURN key id, the SFU app
      // id and session ids. Requests are traced (without URLs) instead.
      "System.Net.Http.HttpClient": "Warning",
      // Resilience pipelines log every attempt at Information; retries and failures are Warning and up.
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ForwardedHeaders": {
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Hub": {
      "TokenLimit": 20,
      "TokensPerSecond": 5
    }
  },
  "Turn": {
    "Cloudflare": {
      "KeyId": "",
      "ApiToken": ""
    },
    "CredentialTtlSeconds": 14400,
    "ForceRelay": false
  },
  "Sfu": {
    "Cloudflare": {
      "AppId": "",
      "AppSecret": ""
    }
  }
}
